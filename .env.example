# --- Google keys ---------------------------------------------------------
# Enable "Places API (New)" and "Maps JavaScript API" in Google Cloud.
#
# Server key: used by this server to call Places API (New). Restrict it by
# IP address and to the Places API (New) only. Never expose it to the browser.
GOOGLE_PLACES_API_KEY=

# Browser key: sent to the browser to load the map. Restrict it by HTTP
# referrer (e.g. http://localhost:3000/*) and to the Maps JavaScript API only.
GOOGLE_MAPS_BROWSER_KEY=

# Optional: Map ID (required for the advanced markers used here). The default
# DEMO_MAP_ID works for development; create your own for production.
GOOGLE_MAP_ID=DEMO_MAP_ID

# --- Tuning (all optional) ------------------------------------------------
PORT=3000
# Max diagonal of a search area, in km (bigger areas = more API calls).
MAX_SEARCH_KM=10
# Max Nearby Search calls per search (hard cost cap).
MAX_PLACES_REQUESTS=40
# Parallel website checks.
CHECK_CONCURRENCY=6
# How long a website check is cached, in days.
CACHE_TTL_DAYS=14
# Venue types to search (Places API Table A types).
PLACE_TYPES=bar,pub,restaurant,hotel
# Also scan Google review text for "Guinness" (slightly pricier Places SKU).
INCLUDE_REVIEWS=true
